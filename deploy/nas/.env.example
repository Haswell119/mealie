# Copier ce fichier en `.env`, puis le remplir. Ne jamais mettre de mot de passe ici :
# les secrets vivent dans deploy/nas/secrets/ (voir README.md).

# Image à exécuter. Format conseillé : <version amont>-pe.<n>
MEALIE_IMAGE=ghcr.io/haswell119/mealie-pe:3.31.0-pe.1

# Port de l'hôte. Laisser vide tant que ./audit-nas.sh n'a pas confirmé qu'il est libre.
MEALIE_PORT=

# Interface d'écoute : 127.0.0.1 (derrière un reverse proxy ou `tailscale serve`)
# ou l'adresse Tailscale du NAS (100.x.y.z). Ne pas utiliser 0.0.0.0.
MEALIE_BIND_IP=127.0.0.1

# Adresse à laquelle vous ouvrez l'application, en HTTPS.
BASE_URL=https://nas.exemple.ts.net

# Dossier du NAS qui reçoit les sauvegardes chiffrées (chemin absolu, hors des volumes Docker).
BACKUP_DIR=/volume1/sauvegardes/mealie-pe

# Heure de la sauvegarde quotidienne et durée de conservation.
BACKUP_TIME=03:30
BACKUP_KEEP_DAYS=30

TZ=Europe/Zurich
# Utilisateur du NAS propriétaire des fichiers (commande : id)
PUID=1000
PGID=1000
